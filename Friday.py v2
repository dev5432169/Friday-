    def handle_web_search(self, command_text):
        """Opens Google to search for a specified term."""
        
        # Prioritize extracting the search term after a common command prefix
        search_prefixes = ["search for", "google", "look up", "what is"]
        search_term = ""
        
        for prefix in search_prefixes:
            if prefix in command_text:
                search_term = command_text.split(prefix, 1)[-1].strip()
                break
        
        if not search_term:
            self.speak("What exactly should I search for on the web?")
            search_term = self.listen(timeout=5, phrase_time_limit=5)
            if search_term in ["unknown", "timeout", "request_error"]:
                self.speak("Aborting search.")
                return

        search_url = f"https://www.google.com/search?q={search_term.replace(' ', '+')}"
        self.speak(f"Searching Google for {search_term}.")
        webbrowser.open(search_url)

    # --- Main Loop ---
