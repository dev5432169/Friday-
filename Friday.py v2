    def speak(self, text):
        """Standardized text-to-speech function, respecting the mute state."""
        print(f"Friday: {text}")
        if not self.is_muted:
            self.engine.say(text)
            self.engine.runAndWait()

    def listen(self, timeout=5, phrase_time_limit=8):
        """Listens for user input and returns the recognized text."""
        with self.microphone as source:
            self.recognizer.adjust_for_ambient_noise(source, duration=1.0) # type: ignore
            print("🎙️ Listening...")
            try:
                audio = self.recognizer.listen(source, timeout=timeout, phrase_time_limit=phrase_time_limit)
                text = self.recognizer.recognize_google(audio) # type: ignore
                print(f"You said: {text}")
                return text.lower()
            except sr.WaitTimeoutError:
                return "timeout"
            except sr.UnknownValueError:
                return "unknown"
            except sr.RequestError:
                return "request_error"

    def greet_user(self):
