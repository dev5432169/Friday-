    def handle_weather_command(self, command_text=None):
        """Prompts for location and fetches weather data."""
        # ⚠️ ACTION REQUIRED: REPLACE 'YOUR_OPENWEATHERMAP_API_KEY' with your actual key
        api_key = os.getenv("OPENWEATHERMAP_API_KEY", "YOUR_OPENWEATHERMAP_API_KEY")
        
        if api_key == "YOUR_OPENWEATHERMAP_API_KEY":
            self.speak("The weather API key is not set. Please update the code with your OpenWeatherMap key.")
            return

        self.speak("Which city and country would you like the weather for?")
        location_input = self.listen(timeout=5, phrase_time_limit=5)

        if location_input in ["unknown", "timeout", "request_error"]:
            self.speak("Sorry, I couldn't understand the location.")
            return

        try:
            url = f"http://api.openweathermap.org/data/2.5/weather?q={location_input}&appid={api_key}&units=metric"
            response = requests.get(url, timeout=10).json()

            if response.get("cod") != 200:
                self.speak(f"Sorry, I couldn't find weather data for {location_input}.")
                return

            temp = response["main"]["temp"]
            condition = response["weather"][0]["description"].capitalize()
            city = response.get("name", location_input)
            report = f"In {city}, it's currently {temp:.1f}°C with {condition}."
            self.speak(report)
        except Exception as e:
            print(f"Weather Fetch Error: {e}")
            self.speak("There was a problem fetching the weather data.")

