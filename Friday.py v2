        if now.hour < 12:
            greeting = "Good morning"
        elif now.hour < 18:
            greeting = "Good afternoon"
        else:
            greeting = "Good evening"
        self.speak(f"{greeting} {self.user_name}! I'm Friday, ready to assist. What can I do today?")

