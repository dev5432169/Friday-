    async def _generate_and_play_voice(self, text: str):
        """Uses gTTS to generate and play high-quality voice."""
        try:
            # Using 'com' TLD for a standard, clear US English voice accent
            tts = gTTS(text=text, lang='en', tld='com', slow=False)
            speech_file = "friday_speech.mp3"
            tts.save(speech_file)
            await asyncio.to_thread(playsound, speech_file)
            os.remove(speech_file)
            return True
        except Exception as e:
            print(f"Error during high-quality voice generation: {e}")
            return False

    async def speak(self, text):
        """Asynchronous text-to-speech function, respecting the mute state."""
        print(f"Friday: {text}")
        if not self.is_muted:
            # Try high-quality voice first
            if not await self._generate_and_play_voice(text):
                # Fallback to offline voice
                await asyncio.to_thread(self.engine.say, text)
                await asyncio.to_thread(self.engine.runAndWait)

    async def listen(self, timeout=5, phrase_time_limit=8):
        """Asynchronously listens for user input and returns the recognized text."""
        with self.microphone as source:
            # Run blocking I/O in a separate thread
            await asyncio.to_thread(self.recognizer.adjust_for_ambient_noise, source, duration=0.5) # type: ignore
            print("🎙️ Listening...")
            try:
                audio = await asyncio.to_thread(self.recognizer.listen, source, timeout=timeout, phrase_time_limit=phrase_time_limit)
                text = await asyncio.to_thread(self.recognizer.recognize_google, audio) # type: ignore
                print(f"You said: {text}")
                return text.lower()
            except sr.WaitTimeoutError:
                return "timeout"
            except sr.UnknownValueError:
                return "unknown"
            except sr.RequestError as e:
                print(f"Network error with speech recognition: {e}")
                return "request_error"

    async def greet_user(self):
        """Provides a personalized, time-sensitive greeting."""
        now = datetime.datetime.now()
        if now.hour < 12:
            greeting = "Good morning"
        elif now.hour < 18:
            greeting = "Good afternoon"
        else:
            greeting = "Good evening"
        await self.speak(f"{greeting} {self.user_name}! I'm Friday, ready to assist. What can I do today?")

    # --- NEW COMMAND IMPLEMENTATIONS ---

    async def check_status(self, command_text=None):
        """Reports on Friday's current state."""
        status = "All systems are nominal. My temperature is stable, and I am currently not processing any complex background tasks."
        if self.is_muted:
            status += " Note: I am currently in silent mode."
        await self.speak(status)

