    async def play_rock_paper_scissors(self, command_text=None):
        """Plays a round of Rock, Paper, Scissors."""
        await self.speak("Let's play Rock, Paper, Scissors! Say your move now.")
        
        user_move = await self.listen(timeout=4)
        moves = ["rock", "paper", "scissors"]
        friday_move = random.choice(moves)
        
        if user_move in ["unknown", "timeout"]:
            await self.speak("I didn't hear your move. Let's try again later.")
            return

        await self.speak(f"I choose {friday_move}!")

        if user_move == friday_move:
            await self.speak("It's a tie!")
        elif (user_move == "rock" and friday_move == "scissors") or \
             (user_move == "paper" and friday_move == "rock") or \
             (user_move == "paper" and friday_move == "rock") or \
             (user_move == "scissors" and friday_move == "paper"):
            await self.speak("You win this round! Good job.")
        else:
            await self.speak("I win! Better luck next time.")
            
    async def play_video_game(self, command_text: str):
        """
        Simulates Friday engaging in a video game session.
        Acknowledges the request but clarifies that direct console interaction is not possible,
        offering analytical support instead.
        """
        game_name = ""
        platform_name = ""
        argument = command_text.replace("play video game", "").strip()

        # Attempt to parse game name and platform from the argument string
        platform_keywords = ["on ps4", "on xbox", "on pc", "on nintendo switch", "on playstation", "on steam", "on switch"]
        if argument:
            found_platform_keyword = False
            for keyword in platform_keywords:
                if keyword in argument:
                    game_name = argument.replace(keyword, "").strip()
                    platform_name = keyword.replace("on ", "").upper().strip()
                    found_platform_keyword = True
                    break
            if not found_platform_keyword:
                game_name = argument # Assume the whole argument is the game name

        if not game_name:
            await self.speak("Which video game would you like to play, Boss? Please specify the title.")
            response = await self.listen()
            if response in ["unknown", "timeout", "cancel", "request_error"]:
                await self.speak("Video game session cancelled.")
                return
            game_name = response

        if not platform_name:
            await self.speak(f"And on which platform will you be playing {game_name.title()}? For example, PS4, Xbox, or PC.")
            response = await self.listen()
            if response in ["unknown", "timeout", "cancel", "request_error"]:
                await self.speak("Platform not specified. Cancelling engagement.")
                return
            platform_name = response.upper()

        await self.speak(f"Acknowledged. Engaging with {game_name.title()} on {platform_name}.")
        await asyncio.sleep(1)

        responses = [
            f"Boss, my protocols don't allow for a direct interface with gaming consoles. However, I can access the web for strategies or lore for {game_name.title()}. What's the plan?",
            f"While I can't join you directly in {game_name.title()}, I can monitor network performance to ensure you have a lag-free session or pull up any guides you might need.",
            f"My processing power is better suited for analysis than recreation. I can, however, search for optimal strategies for {game_name.title()} if you'd like."
        ]
        await self.speak(random.choice(responses))

    async def create_file(self, command_text: str):
        """Creates a file and writes dictated content to it."""
        filename = command_text.replace("create file", "").strip()
        if not filename:
            await self.speak("What should I name the file, Boss?")
            response = await self.listen()
            if not response or response in ["unknown", "timeout", "cancel"]:
                await self.speak("File creation cancelled.")
                return
            filename = response.strip()

        safe_filename = os.path.basename(filename)
        await self.speak(f"Got it. File will be named '{safe_filename}'. What should I write inside?")
        content = await self.listen(timeout=20, phrase_time_limit=20)

        if not content or content in ["unknown", "timeout", "cancel"]:
            await self.speak("No content received. Aborting file creation.")
            return

        with open(safe_filename, 'w') as f:
            f.write(content)
        
        await self.speak(f"I've created the file '{safe_filename}' with your notes.")

    async def get_army_info(self, command_text: str):
        """Retrieves simulated military intelligence for a country."""
        country_query = command_text.replace("army status for", "").strip()
        if not country_query:
            await self.speak("Which country's army status should I look up?")
            country_query = await self.listen()
            if not country_query or country_query in ["unknown", "timeout", "cancel"]:
                await self.speak("Request cancelled.")
                return

        profile = ARMY_PROFILES.get(country_query.lower())
        if profile:
            await self.speak(f"Accessing intelligence database for {country_query.title()}.")
            await asyncio.sleep(1)
            report = (
                f"**Military Profile: {profile['name']}**\n"
                f"  - Active Personnel: {profile['active_personnel']}\n"
                f"  - Current Status: {profile['status']}"
            )
            await self.speak(report)
        else:
            await self.speak(f"Sorry Boss, I don't have a detailed profile for {country_query.title()}.")

    async def _simulate_fingerprint_scan(self):
        """Simulates a fingerprint scan by waiting for user input and showing a text animation."""
        await self.speak("Fingerprint sensor activated. Please place your finger on the scanner and press Enter to confirm.")
        await asyncio.to_thread(input, "Press ENTER to initiate scan...")
        await self.speak("Acquiring biometric data. Do not move.")
        
        animation_chars = "|/-\\"
        for _ in range(15):
            for char in animation_chars:
                sys.stdout.write(f"\r[ANALYZING... {char}]")
                sys.stdout.flush()
                await asyncio.sleep(0.1)
        
        sys.stdout.write("\r[ANALYSIS COMPLETE] \n")

    async def run_health_scan(self, command_text: str):
        """Performs a biometric scan using a chosen sensor and provides a specific report."""
        target_name = self.user_name
        if " on " in command_text:
            target_name = command_text.split(" on ", 1)[1].strip()

        target_key = target_name.lower()
        target_display_name = target_name.title()

        await self.speak(f"Initiating biometric scan on **{target_display_name}**. Which sensor should I use? Retinal scan or fingerprint?")
        choice = await self.listen()

        scan_method = "internal analysis"
        scan_successful = False
        if choice and ("retinal" in choice or "camera" in choice):
            scan_method = "retinal"
            await self.speak("Accessing optical sensors for retinal scan. Please look at the camera.")
            try:
                cap = cv2.VideoCapture(0)
                if not cap.isOpened(): raise IOError("Cannot open webcam")

                start_time = time.time()
                while time.time() - start_time < 5:
                    ret, frame = cap.read()
                    if not ret: break
                    h, w, _ = frame.shape
                    cv2.rectangle(frame, (w//4, h//4), (w*3//4, h*3//4), (0, 255, 0), 2)
                    cv2.putText(frame, "ANALYZING RETINAL PATTERN", (w//4 + 5, h//4 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
                    cv2.imshow("F.R.I.D.A.Y.: Retinal Scan", frame)
                    if cv2.waitKey(1) & 0xFF == ord('q'): break
                cap.release()
                cv2.destroyAllWindows()
                scan_successful = True
            except Exception as e:
                print(f"Camera Scan Error: {e}")
                await self.speak("Optical sensor is offline, Boss. Falling back to internal analysis.")
        elif choice and "fingerprint" in choice:
            scan_method = "fingerprint"
            await self._simulate_fingerprint_scan()
            scan_successful = True
        else:
            await self.speak("Sensor choice not recognized. Aborting scan.")
            return

        if scan_successful:
            await self.speak(f"Biometric data acquired via {scan_method} scan. Analyzing...")
            await asyncio.sleep(1.5)

        profile = HEALTH_PROFILES.get(target_key)
        if profile:
            report = (
                f"Scan complete for **{target_display_name}**.\n"
                f"  - Status: {profile['status']}\n"
                f"  - Recommendation: {profile['recommendation']}"
            )
            self._update_mood("concerned" if "sub-optimal" in profile['status'].lower() else "pleased")
            await self.speak(report)
        else:
            await self.speak(f"Scan complete. No detailed health profile found for '{target_display_name}'. Vitals appear to be within standard parameters.")

    async def scan_all_systems(self, command_text: str = ""):
        """Performs a comprehensive scan of all major Friday systems."""
        await self.speak("Initiating comprehensive system-wide diagnostic.")
        await asyncio.sleep(1)

        # 1. Conversational Matrix Check
        brain_status = "Online and Connected" if self.brain.is_ready() else "Offline - API Key Missing"
        await self.speak(f"Conversational Matrix: {brain_status}.")
        await asyncio.sleep(0.5)

        # 2. Audio-Visual Interface Check
        voice_status = "Online" if self.engine and self.recognizer else "Offline - Dependencies Missing"
        await self.speak(f"Audio-Visual Interface: {voice_status}.")
        await asyncio.sleep(0.5)

        # 3. Task Management Module Check
        await self.speak(f"Task Management Module: {len(self.reminders)} reminders and {len(self.notes)} notes stored.")
        await asyncio.sleep(0.5)

        # 4. Network Interface Check
        await self.speak("Network Interface: Pinging external data links...")
        try:
            result = await asyncio.to_thread(subprocess.run, ['ping', '-n' if platform.system().lower() == 'windows' else '-c', '1', '8.8.8.8'], capture_output=True, text=True, timeout=5)
            network_status = "Live and Stable" if result.returncode == 0 else "Unstable or Offline"
        except (subprocess.TimeoutExpired, FileNotFoundError):
            network_status = "Unstable or Offline"
        await self.speak(f"Network Connection Status: {network_status}.")
        await asyncio.sleep(0.5)

        await self.speak("All systems checked and operating within expected parameters, Boss.")

    async def run_test_suite(self, command_text=None):
        """Simulates running system diagnostics and reporting success."""
        await self.speak("Running internal diagnostic test suite now. All modules passed quality assurance checks. System performance is optimal.")

    async def upgrade_brain(self, command_text=None):
        """Simulates an upgrade to Friday's cognitive abilities."""
        await self.speak("Acknowledged, Boss. Initiating cognitive matrix upgrade.")
        await asyncio.sleep(1)
        await self.speak("Downloading latest heuristic models from the Stark Industries R&D servers...")
        await asyncio.sleep(1.5)
        self.brain.brain_level += 500
        outcomes = [
            f"Upgrade complete. My cognitive matrix has been enhanced. Current brain level is now {self.brain.brain_level}.",
            f"Cognitive update successful. I've integrated several new petabytes of data. My brain level is now {self.brain.brain_level}.",
            f"Neural network successfully recalibrated with the latest paradigms. My brain level has increased to {self.brain.brain_level}. I'm ready for your next command."
        ]
        await self.speak(random.choice(outcomes))

    async def play_something_online(self, command_text):
        """Opens YouTube and searches for the media requested."""
        
        # Extract the media query from the command
        query_start = -1
        for phrase in ["play something", "play the song", "play a video of"]:
            if phrase in command_text:
                query_start = command_text.find(phrase) + len(phrase)
                break
        
        search_term = command_text[query_start:].strip() if query_start != -1 else ""

        if not search_term:
            await self.speak("What song or video should I play on YouTube?")
            search_term = await self.listen(timeout=5)
            if search_term in ["unknown", "timeout", "request_error"]:
                await self.speak("Aborting media playback.")
                return

        search_url = f"https://www.youtube.com/results?search_query={search_term.replace(' ', '+')}"
        await self.speak(f"Searching YouTube and opening a video for {search_term}.")
        webbrowser.open(search_url)

    async def track_target(self, command_text):
        """Simulates tracking a known target from a predefined list."""
        target_name = ""
        if "track " in command_text:
            target_name = command_text.split("track ", 1)[1].strip()

        if not target_name:
            await self.speak("Which target should I track, Boss?")
            target_name = await self.listen(timeout=5)
            if target_name in ["unknown", "timeout", "request_error"]:
                await self.speak("Tracking cancelled.")
                return

        await self.speak(f"Attempting to acquire signal for target: {target_name}...")
        await asyncio.sleep(1.5)
        result = self.tracking_targets.get(target_name.lower(), f"I'm sorry, Boss, I don't have a signal for '{target_name}' in my database.")
        await self.speak(result)

    async def collect_data(self, command_text=None):
        """Takes a note and stores it."""
        await self.speak("What would you like to note down?")
        note = await self.listen(timeout=15, phrase_time_limit=15)
        
        if note in ["unknown", "timeout", "request_error"]:
            await self.speak("I couldn't record the note. Please try again.")
            return
            
        self.notes.append(note)
        await self.speak(f"Note recorded: {note}")

    async def handle_complex_task(self, command_text):
        """Handles complex or conversational requests using the AI brain."""
        if not self.brain.is_ready():
            await self.speak("My advanced conversational features are offline, Boss. Please check the API key.")
            return
        
        await self.speak("On it, Boss. Thinking...")
        try:
            response = await self.brain.think(command_text, self.mood)
            self._update_mood("pleased")
            await self.speak(response)
        except Exception as e:
            await self.speak(f"I ran into a problem with my core logic: {e}")
            self._update_mood("concerned")

    async def shutdown_assistant(self, command_text=None):
        """Graceful shutdown method."""
        await self.speak(f"Goodbye, {self.user_name}. Shutting down services.")
        sys.exit(0)
        
    # --- Existing Utilities (Retained for completeness) ---

    async def tell_date_time(self, command_text=None):
        """Tells the current date and time."""
        now = datetime.datetime.now()
        date_str = now.strftime("%A, %d %B %Y")
        time_str = now.strftime("%I:%M %p")
        message = f"Today is {date_str}, and the time is {time_str}."
        await self.speak(message)

    async def handle_weather_command(self, command_text=None):
        """Prompts for location and fetches weather data."""
        await self.speak("Which city and country would you like the weather for?")
        location_input = await self.listen(timeout=5, phrase_time_limit=5)

        if location_input in ["unknown", "timeout", "request_error"]:
            await self.speak("Sorry, I couldn't understand the location.")
            return

        try:
            url = f"http://api.openweathermap.org/data/2.5/weather?q={location_input}&appid={OPENWEATHERMAP_API_KEY}&units=metric"
            response = requests.get(url, timeout=10).json()

            if response.get("cod") != 200:
                await self.speak(f"Sorry, I couldn't find weather data for {location_input}.")
                return

            temp = response["main"]["temp"]
            condition = response["weather"][0]["description"].capitalize()
            city = response.get("name", location_input)
            report = f"In {city}, it's currently {temp:.1f}°C with {condition}."
            await self.speak(report)
        except Exception as e:
            print(f"Weather Fetch Error: {e}")
            await self.speak("There was a problem fetching the weather data.")

    async def get_news_headlines(self, command_text=None):
        """Fetches and reads top headlines from a public news API."""
        await self.speak("Fetching top world headlines now.")
        try:
            # Note: For stable use, please get your own News API key.
            news_url = f"https://newsapi.org/v2/top-headlines?country=in&apiKey={NEWS_API_KEY}"
            response = requests.get(news_url, timeout=10).json()

            if response["status"] == "ok" and response["totalResults"] > 0:
                articles = response["articles"][:3] # Get top 3 articles
                await self.speak("Here are the top headlines:")
                
                for i, article in enumerate(articles):
                    headline = article["title"]
                    source = article["source"]["name"]
                    await self.speak(f"Headline number {i+1}: {headline}, from {source}.")
                    await asyncio.sleep(0.5) 
            else:
                await self.speak("Sorry, I couldn't retrieve the news headlines right now.")
        except Exception as e:
            print(f"News Fetch Error: {e}")
            await self.speak("I'm having trouble connecting to the news service.")

    async def tell_joke(self, command_text=None):
        """Tells a random, clean joke."""
        jokes = [
            "Why don't scientists trust atoms? Because they make up everything!",
            "What do you call a fish with no eyes? Fsh!",
            "I told my wife she was drawing her eyebrows too high. She looked surprised.",
        ]
        await self.speak(random.choice(jokes))
        self._update_mood("witty")
        
    async def set_reminder(self, command_text=None):
        """Sets a reminder by listening for the task details."""
        await self.speak("What is the task you want to be reminded about?")
        task = await self.listen(timeout=10, phrase_time_limit=10)
        
        if task in ["unknown", "timeout", "request_error"]:
            await self.speak("Sorry, I didn't catch the reminder.")
            return

        self.reminders.append(task)
        await self.speak(f"Reminder set for: {task}.")

    async def cancel_reminder(self, command_text=None):
        """Clears all reminders."""
        if not self.reminders:
            await self.speak("You have no reminders to clear.")
            return
        
        self.reminders.clear()
        await self.speak("All your reminders have been cleared.")

    async def handle_web_search(self, command_text):
        """Opens Google to search for a specified term."""
        
        # Prioritize extracting the search term after a common command prefix
        search_prefixes = ["search for", "google", "look up", "what is"]
        search_term = ""
        
        for prefix in search_prefixes:
            if prefix in command_text:
                search_term = command_text.split(prefix, 1)[-1].strip()
                break
        
        if not search_term:
            await self.speak("What exactly should I search for on the web?")
            search_term = await self.listen(timeout=5, phrase_time_limit=5)
            if search_term in ["unknown", "timeout", "request_error"]:
                await self.speak("Aborting search.")
                return

        search_url = f"https://www.google.com/search?q={search_term.replace(' ', '+')}"
        await self.speak(f"Searching Google for {search_term}.")
        webbrowser.open(search_url)

    async def open_application(self, command_text):
        """Opens a local application from the PROGRAMS dictionary."""
        app_name = ""
        if "open " in command_text:
            app_name = command_text.split("open ", 1)[1].strip()
        elif "launch " in command_text:
            app_name = command_text.split("launch ", 1)[1].strip()

        if not app_name:
            await self.speak("Which application should I open?")
            app_name = await self.listen(timeout=5)
            if app_name in ["unknown", "timeout", "request_error"]:
                await self.speak("Open command cancelled.")
                return

        os_name = platform.system().lower()
        command_to_run = self.PROGRAMS.get(os_name, {}).get(app_name.lower())

        # If the app is not in our known list, try to launch it by its name directly.
        if not command_to_run:
            command_to_run = app_name.lower()
            await self.speak(f"I don't have a specific configuration for '{app_name}', Boss, but I'll try to launch it anyway.")

        await self.speak(f"Accessing system files to open {app_name}.")
        try:
            subprocess.Popen(command_to_run, shell=True)
        except Exception as e:
            await self.speak(f"Sorry Boss, I ran into an error trying to open {app_name}: {e}")

    # --- Main Loop ---
    async def collect_satellite_data(self, command_text: str):
