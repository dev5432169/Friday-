    async def control_all_systems(self, command_text=None):
        """Simulates taking master control of all personal devices."""
        await self.speak("On it, Boss. Initiating the 'House Party' protocol for all your devices.")
        await asyncio.sleep(1.5)
        await self.speak("Connecting to your personal phone, tablet, and workshop terminals...")
        await asyncio.sleep(2)
        await self.speak("Firewalls bypassed. I have full administrative access.")
        await asyncio.sleep(1)
        await self.speak("I'm in. All your devices are now under my control. Ready for your command.")

    async def control_my_device(self, command_text=None):
        """
        Provides a central command for hands-free device control,
        integrating with existing functionalities like opening applications or controlling systems.
        """
        action = command_text.replace("control my device", "").strip()
        if " to " in action:
            action = action.split(" to ", 1)[1]

        if not action:
            await self.speak("Right away, Boss. Activating hands-free device control. What's the plan?")
            response = await self.listen()
            if not response or response in ["unknown", "timeout", "cancel", "nothing"]:
                await self.speak("Hands-free control session ended.")
                return
            action = response

        action_lower = action.lower()

        if "open" in action_lower or "launch" in action_lower:
            # Re-use the existing open_application logic
            await self.open_application(action_lower)
        elif "control all systems" in action_lower or "house party protocol" in action_lower:
            await self.control_all_systems()
        elif "turn on lights" in action_lower or "lights on" in action_lower:
            await self.speak("Simulating smart home integration. Lights are now on, Boss.")
        elif "adjust thermostat" in action_lower or "set temperature" in action_lower:
            await self.speak("Simulating smart home integration. Thermostat adjusted to your preference.")
        else:
            await self.speak(f"Sorry, Boss, I can't perform '{action}' with my current device control protocols.")


    async def activate_profile(self, command_text: str):
        """Activates a workspace profile, opening multiple apps and websites."""
        profile_name = command_text.replace("activate profile", "").strip()
        if not profile_name:
            await self.speak("Which profile should I activate, Boss? For example, 'work' or 'gaming'.")
            response = await self.listen()
            if not response or response in ["unknown", "timeout", "cancel"]:
                await self.speak("Profile activation cancelled.")
                return
            profile_name = response.strip()

        profile = PROFILES.get(profile_name.lower())

        if not profile:
            await self.speak(f"Sorry Boss, I don't have a profile named '{profile_name}'. I can activate: " + ", ".join(PROFILES.keys()))
            return

        await self.speak(f"Activating the **{profile_name.title()}** profile. {profile.get('description', '')}")
        
        tasks = []
        # Gather all website and application opening tasks
        for site in profile.get("websites", []): # webbrowser.open is synchronous
            tasks.append(asyncio.to_thread(webbrowser.open, f"https://{site}"))
        
        for app in profile.get("apps", []):
            # self.open_application is a coroutine, so we can append it directly
            tasks.append(self.open_application(f"open {app}")) 

        # Execute all tasks concurrently
        await asyncio.gather(*tasks)
        await self.speak(f"The **{profile_name.title()}** profile is now active, Boss.")

    async def start(self):
        """Main loop that continuously listens for and processes commands."""
        await self.greet_user()
        
        while True:
            text = await self.listen()

            if text in ["timeout", "unknown", "request_error"]:
                if text == "unknown":
                    if not self.is_muted: # Only speak if not muted
                        await self.speak("Sorry, I didn't catch that. Could you repeat it?")
                await asyncio.sleep(1)
                continue

            command = text

            # 1. Prioritize finding the longest matching command phrase
            found_command = None
            max_len = 0
            
            # Sort command keys by length descending to prioritize longer, more specific phrases
            sorted_commands = sorted(self.command_map.keys(), key=len, reverse=True)
            
            for phrase in sorted_commands:
                if phrase in command:
                    # Found the longest matching command phrase
                    found_command = phrase
                    break
            
            # 2. Execute the command or provide feedback
            if found_command:
                handler = self.command_map[found_command]
                # All handlers now produce a coroutine that must be awaited.
                # This includes async methods and lambdas that call async methods.
                # We need to await the result of the handler call.
                await handler(command)
                
            else:
                # If no specific command is found, treat it as a conversational query for the AI brain.
                await self.handle_complex_task(command)


# --------------------------------------------------------------------------
# --- 3. Script Execution ---
# --------------------------------------------------------------------------

if __name__ == "__main__":
    try:
        assistant = FridayAssistant(user_name="Devansh Prabhakar")
        asyncio.run(assistant.start())
    except KeyboardInterrupt:
        print("\nFriday shutting down due to manual stop (Ctrl+C).")
        sys.exit(0)
    except Exception as e:
        print(f"\nFATAL UNHANDLED ERROR: {e}")
        sys.exit(1)
