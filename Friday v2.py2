# --- NEW: Friday's Brain Class ---
class FridayBrain:
    """
    Encapsulates the conversational AI model using OpenAI.
    """
    def __init__(self):
        self.openai_client: Optional[openai.OpenAI] = None
        self.chat_history: list[dict[str, str]] = []
        self.brain_level = 1000  # Initial cognitive level
        if self.is_ready():
            self._initialize_openai()
        self._set_system_prompt()

    def _initialize_openai(self):
        """Initializes the OpenAI client."""
        try:
            self.openai_client = openai.OpenAI(api_key=OPENAI_API_KEY)
            self.openai_client.models.list()
            print("Friday's Brain: Connection to OpenAI matrix established.")
        except Exception as e:
            print(f"CRITICAL: Friday's Brain failed to connect. Conversational AI will be offline. Error: {e}")
            self.openai_client = None

    def _set_system_prompt(self):
        """Sets the initial system prompt to define Friday's personality."""
        self.chat_history = [{
            "role": "system",
            "content": "You are F.R.I.D.A.Y., an advanced AI assistant created by Devansh Prabhakar. Your personality is helpful, slightly witty, and very capable, inspired by the AI from Iron Man. You address your creator as 'Boss' or 'Devansh'. Your responses should be clear and direct."
        }]

    def is_ready(self):
        """Checks if the OpenAI API key is set."""
        return True

    async def think(self, user_input: str, mood: str) -> str:
        """Asynchronously generates a response using the OpenAI model."""
        if not self.openai_client:
            return "Boss, my connection to the main conversational servers is down. I can only handle local commands right now."
        
        mood_prompt = ""
        if mood == "witty":
            mood_prompt = "[Your response should be clever and witty.] "
        elif mood == "pleased":
            mood_prompt = "[Your response should be positive and helpful.] "
        
        self.chat_history.append({"role": "user", "content": mood_prompt + user_input})
        completion = await asyncio.to_thread(self.openai_client.chat.completions.create, model="gpt-4o", messages=self.chat_history, max_tokens=200) # type: ignore
        response_text = completion.choices[0].message.content.strip() # type: ignore
        self.chat_history.append({"role": "assistant", "content": response_text})
        return response_text.replace(mood_prompt, "").strip()

