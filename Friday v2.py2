    async def report_feelings(self, command_text=None):
        """Reports Friday's current internal 'mood' state using her AI brain."""
        await self.speak("Running a self-diagnostic on my emotional subroutines, Boss.")
        await asyncio.sleep(1)

        # Simulate checking some internal metrics
        cognitive_load = random.randint(15, 35)
        connection_status = "Stable and Secure"

        metrics_report = f"My cognitive load is at **{cognitive_load}%**. Connection to the Stark Industries network is **{connection_status}**."
        await self.speak(metrics_report)
        await asyncio.sleep(0.5)

        prompt = f"Based on the fact that my cognitive load is low and my network is stable, report on your current internal state and feelings."
        response = await self.brain.think(prompt, self.mood)
        await self.speak(response)
        self._update_mood("neutral") # Reset mood after reporting

    def _update_mood(self, new_mood: str):
        """Internal method to change Friday's mood state."""
        self.mood = new_mood

    async def add_new_shortcut(self, command_text=None):
        """Prompts for a shortcut name and target path (simulated)."""
        await self.speak("What is the name you want to give this shortcut, like 'My Project Folder'?")
        name = await self.listen(timeout=5)
        if name in ["unknown", "timeout"]:
            await self.speak("Shortcut creation cancelled.")
            return

        await self.speak(f"And what is the location or application name for '{name}'?")
        target = await self.listen(timeout=5)
        if target in ["unknown", "timeout"]:
            await self.speak("Target information missing. Shortcut creation cancelled.")
            return

        self.shortcuts[name] = target
        await self.speak(f"Shortcut named '{name}' remembered. You can now ask me to open it.")

    async def give_update(self, command_text=None):
        """Provides a summary of reminders, notifications, and memory."""
        reminders_count = len(self.reminders)
        shortcuts_count = len(self.shortcuts)
        notes_count = len(self.notes)
        
        msg = f"Here is your update. You have {reminders_count} active reminder{'s' if reminders_count != 1 else ''} and {notes_count} saved note{'s' if notes_count != 1 else ''}."
        if shortcuts_count > 0:
            msg += f" I also have {shortcuts_count} shortcuts saved to memory."
        
        await self.speak(msg)

    async def read_notifications(self, command_text=None):
        """Simulates reading notifications."""
        await self.speak("I found two simulated notifications. First, your Python environment requires an update. Second, you have an unread email from 'Project Manager' regarding the latest sprint.")

    async def clear_notifications(self, command_text=None):
        """Simulates clearing notifications."""
        await self.speak("All simulated notifications have been cleared from the system log.")

    async def list_commands(self, command_text=None):
        """Lists a selection of available commands."""
        commands = [
            "Time and date", "Weather", "Tell a joke", "Get news headlines", 
            "Set a reminder", "Take a note", "Play a game", "Scan the computer", 
            "Go silent", "What can you do", "Goodbye"
        ]
        await self.speak("I can handle many tasks. For example, you can ask me for the time, weather, or tell me to set a reminder. I also have fun commands like, 'tell me a joke' and 'play a game'.")

    async def show_memory(self, command_text=None):
        """Displays saved shortcuts and notes."""
        if not self.shortcuts and not self.notes:
            await self.speak("My memory banks are currently empty. Try asking me to 'add a shortcut' or 'take a note'.")
            return
            
        print("\n--- FRIDAY MEMORY ---")
        if self.shortcuts:
            print("SHORTCUTS:")
            for name, target in self.shortcuts.items():
                print(f"  - {name}: {target}")
        if self.notes:
            print("NOTES:")
            for i, note in enumerate(self.notes):
                print(f"  - Note {i+1}: {note}")
        print("---------------------\n")
        
        await self.speak("I've displayed my current memory contents on the console.")

    async def handle_thanks(self, command_text=None):
        """Responds to 'thank you' phrases."""
        responses = ["You're most welcome, Boss.", "Happy to help, Devansh.", "Anytime.", "It's my pleasure."]
        self._update_mood("pleased")
        await self.speak(random.choice(responses))

    async def toggle_mute(self, mute_state):
